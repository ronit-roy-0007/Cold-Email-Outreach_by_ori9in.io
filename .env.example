# ==============================================================================
# IntentLead AI - Environment Configuration Example
# Copy this file to .env and configure for your environment.
# ==============================================================================

# Application Environment (development / production)
APP_ENV=development
LOG_LEVEL=INFO

# Database Connection URL
# For quick local development (SQLite):
DATABASE_URL=sqlite:///./intentlead.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://intentlead:your_secure_db_password@db:5432/intentlead

# Discovery Scraper Provider ("scrapling", "google_maps", "mock")
# "scrapling" uses stealth headless crawling for Google Maps discovery
DISCOVERY_PROVIDER=scrapling

# Optional Go Google Maps Scraper (if running legacy scraper service)
GOOGLE_MAPS_SCRAPER_BASE_URL=http://localhost:8080
GOOGLE_MAPS_SCRAPER_API_TOKEN=

# Agency Identity & Default Branding
AGENCY_NAME=Acme Growth Labs
AGENCY_SENDER_NAME=Alex

# Outreach Safety Switch (CRITICAL SAFEGUARD)
# Set to false ONLY when ready to dispatch real emails. Defaults to true.
OUTREACH_DRY_RUN=true

# Telegram Bot Automation (@BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_numeric_telegram_user_id
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# API Security, CORS & Rate Limiting
# Optional API Key for programmatic REST access (if empty, allows open local dev)
API_KEY=
RATE_LIMIT_PER_MINUTE=60
# In development: "*" is allowed. In production: specify explicit comma-separated domains
CORS_ORIGINS=*

# Google Gemini / LLM API Key (for prospect website audits & AI pitch personalization)
USER_LLM_API_KEY=your_gemini_api_key_here
USER_LLM_MODEL=gemini-1.5-flash
USER_LLM_BASE_URL=

# Email Dispatch Configuration
EMAIL_PROVIDER=smtp
SENDER_EMAIL=outreach@yourdomain.com

# Primary SMTP Fallback Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=outreach@yourdomain.com
SMTP_PASSWORD=your_email_app_password
SMTP_USE_TLS=true

# Multi-Mailbox Pool Configuration
MAILBOXES_FILE=mailboxes.json
MAX_EMAILS_PER_DAY=40
ENABLE_DISPATCH_PACING=true

# Compliance & Unsubscribe Settings
AGENCY_PHYSICAL_ADDRESS=100 Innovation Way, Suite 400, Wilmington, DE 19801
UNSUBSCRIBE_BASE_URL=http://localhost:8000/unsubscribe
UNSUBSCRIBE_SECRET=replace_with_a_secure_random_string_min_32_chars

# Credential Encryption at Rest (Fernet authenticated encryption)
FIELD_ENCRYPTION_KEY=replace_with_fernet_key_or_32_char_secret

# Webhook Cryptographic Verification Secrets
RESEND_WEBHOOK_SECRET=whsec_your_resend_svix_secret_here
OUTREACH_WEBHOOK_SECRET=your_custom_esp_hmac_secret_here
MAILGUN_WEBHOOK_SIGNING_KEY=

# Distributed Redis (Required in Production for Replay Protection and Distributed Rate Limiting)
REDIS_URL=redis://redis:6379/0
TRUSTED_PROXIES=127.0.0.1,::1
